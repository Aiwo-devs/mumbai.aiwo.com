# AIWO Mumbai — booking backend configuration (names only; NO secrets committed).
# Copy to `.env.local` (git-ignored) and fill with the real values for the
# environment you're wiring up. Ported from the add-booking branch
# (src/api/bookingService.ts), consumed by the current UI's BookingForm.

# healthportal booking/appointment/service API base (e.g. https://<host>/api).
# When set, the browser calls this directly (add-booking's approach) and it takes
# precedence over the same-origin /api and Netlify-proxy fallbacks. Leave unset in
# environments without a reachable/CORS-enabled backend — booking then fails closed
# (shows a normal error, never a fake success or a wrong-branch call).
VITE_API_BASE_URL=

# healthportal auth/registration API base (e.g. https://<host>/auth-api).
VITE_AUTH_BASE_URL=

# NOTE: Razorpay keys and any backend secrets must live SERVER-SIDE (backend /
# payment-order creation), never in this frontend env. The Mumbai branch is
# identified in code by public, non-secret constants (BRANCH_CODE "MUM",
# BRANCH_ID) in src/service-site/components/sections/BookingForm.tsx.
